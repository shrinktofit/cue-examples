{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "@cocos/creator-types/engine",
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "eslint*.js",
    "scripts/**/*.ts",
    "basic/**/*.ts",
    "basic/**/*.js",
    "basic/**/*.cc.vue",
    "game-ui-showcase/**/*.ts",
    "game-ui-showcase/**/*.js",
    "game-ui-showcase/**/*.cc.vue",
  ],
  "exclude": [
    "**/node_modules",
    "**/temp",
    "**/library",
    "**/local",
    "**/build",
    "**/native",
    "**/extensions",
    "**/assets/oms.ts",
  ]
}
